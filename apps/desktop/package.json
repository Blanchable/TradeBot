{
  "name": "@kalshi-bot/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"tsc -w --project tsconfig.main.json\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc --project tsconfig.main.json && vite build",
    "start": "electron .",
    "pack": "electron-builder --win",
    "lint": "eslint src/",
    "test": "echo no tests yet"
  },
  "dependencies": {
    "@kalshi-bot/shared": "workspace:*",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0",
    "lightweight-charts": "^4.1.0",
    "lucide-react": "^0.300.0"
  },
  "description": "Kalshi Trend Trader - Desktop trading bot",
  "author": "Kalshi Trend Trader",
  "build": {
    "appId": "com.kalshi-bot.desktop",
    "productName": "Kalshi Trend Trader",
    "forceCodeSigning": false,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "KalshiTrendTrader-portable.exe"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend_modules"
      },
      {
        "from": "../../packages/shared/dist",
        "to": "shared"
      },
      {
        "from": "../../config",
        "to": "config"
      },
      {
        "from": "../../.env.example",
        "to": ".env.example"
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
